<h1>Restaurants index</h1>

<ul style="list-style-type: none">
<% @tasks.each do |task| %>
  <li>
  <input type="checkbox">
    <%= link_to "#{task.id} - #{task.title}", task_path(task)%>
    <%= link_to 'Delete', task_path(task),
            data: {turbo_method: :delete, turbo_confirm: "Are you sure?"}
        %>
  </li>
<% end %>
</ul>
