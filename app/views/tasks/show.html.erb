<h2><%= @task.title %></h2>

<p><%= @task.details %></p>

<% if @task.completed %>
  <div style="display: flex;">
    <input type="checkbox" checked>
    <p>This task is completed</p>
  </div>
<% else %>
  <div style="display: flex;">
    <input type="checkbox">
    <p>This task is not completed yet</p>
  </div>
<% end %>

<button><%= link_to 'Edit the task', edit_restaurant_path %></button>
